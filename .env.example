# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://rfi:rfi@127.0.0.1:5433/rfi

# openai_compatible | anthropic | bedrock
LLM_PROVIDER=openai_compatible
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional OpenAI-compatible gateway (OpenRouter, Azure, Groq, vLLM)
LLM_BASE_URL=

# openai_compatible | bedrock  (Anthropic has no embeddings API)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=1536

# Optional rerank after hybrid RRF: jina | cohere | openai_compatible
RERANK_PROVIDER=
RERANK_MODEL=
RERANK_API_KEY=
RERANK_BASE_URL=

# Retrieval thresholds (tunable without code changes)
MEMORY_ACCEPT=0.88
DOC_MIN_SCORE=0.15
MEMORY_TTL_DAYS=365
SESSION_INDEX_RETENTION_DAYS=30
TRACE_RETENTION_DAYS=90

# Optional comma-separated HTTPS hosts. Empty allows any public host.
FETCH_ALLOWLIST=

# Interactive Ask budgets. ASK_MAX_COST_USD=0 disables the cost ceiling.
ASK_WALL_SECONDS=45
ASK_MAX_STEPS=8
ASK_MAX_INPUT_TOKENS=80000
ASK_MAX_COST_USD=0
ASK_USD_PER_MILLION_INPUT=0.15
ASK_USD_PER_MILLION_OUTPUT=0.60
BATCH_QUESTION_WALL_SECONDS=30
BATCH_QUESTION_MAX_STEPS=4

# Google Drive (Web application OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# AWS Bedrock (only if LLM_PROVIDER or EMBEDDING_PROVIDER is bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

FRONTEND_ORIGIN=http://localhost:3000
DATA_DIR=./data
